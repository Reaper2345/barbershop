# Use a flat node_modules layout.
#
# Vite's build pipeline imports `esbuild` and `rollup` directly, which are
# transitive dependencies of vite rather than direct ones. pnpm's default
# isolated linker does not expose them at the top level, so the build fails
# with ERR_MODULE_NOT_FOUND. The hoisted layout matches what npm would
# produce and is what the Laravel + Vite tooling expects.
node-linker=hoisted

# esbuild ships a platform binary through a postinstall script. pnpm blocks
# dependency build scripts by default; without this the binary is never
# written and `vite build` fails with "You installed esbuild for another
# platform". Only esbuild (and rollup) need the exemption.
onlyBuiltDependencies[]=esbuild
